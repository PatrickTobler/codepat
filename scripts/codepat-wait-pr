#!/bin/bash
# Usage: codepat-wait-pr <owner/repo> <pr-number>
# Waits until the PR is merged or closed, a required check fails, or it falls behind main.
# Exit 0: merged or closed. Exit 1: failing required check. Exit 3: behind main. Exit 4: conflicts with main. Fix 3 or 4 only if CodePat opened this PR.
set -u
repo=$1; pr=$2
while :; do
  view=$(gh pr view "$pr" --repo "$repo" --json state,mergeStateStatus -q ".state+\" \"+.mergeStateStatus") || { sleep 60; continue; }
  state=${view%% *}; merge=${view#* }
  [ "$state" != OPEN ] && { echo "PR #$pr is $state"; exit 0; }
  failed=$(gh pr checks "$pr" --repo "$repo" --required --json bucket -q "[.[]|select(.bucket==\"fail\")]|length" 2>/dev/null || echo 0)
  [ "${failed:-0}" -gt 0 ] && { echo "PR #$pr has $failed failing required checks"; exit 1; }
  [ "$merge" = BEHIND ] && { echo "PR #$pr is behind main. Update it only if CodePat opened it; otherwise tell the task and leave it to the author"; exit 3; }
  [ "$merge" = DIRTY ] && { echo "PR #$pr conflicts with main. Resolve it only if CodePat opened it; otherwise tell the task and leave it to the author"; exit 4; }
  sleep 60
done
